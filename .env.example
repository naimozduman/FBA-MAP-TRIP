# Copy into secure local/provider environment settings; never commit real values.
FIELDWORK_ENVIRONMENT=local
SUPABASE_ENVIRONMENT=local
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Independent project URLs are non-secret pins checked against deployment environment.
FIELDWORK_PREVIEW_SUPABASE_URL=
FIELDWORK_PRODUCTION_SUPABASE_URL=
# Restricted browser token for maps; Directions token stays server-only.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_TOKEN=
# Operator scripts only; never NEXT_PUBLIC and never required by web runtime.
FIELDWORK_DATABASE_URL=
FIELDWORK_IMPORT_WORKSPACE_ID=
FIELDWORK_IMPORT_ACTOR_ID=
FIELDWORK_IMPORT_APPROVED_WORKSPACE=
FIELDWORK_BOOTSTRAP_WORKSPACE_ID=
FIELDWORK_BOOTSTRAP_OWNER_ID=
FIELDWORK_BOOTSTRAP_PARTNER_ID=
FIELDWORK_BOOTSTRAP_APPROVED_WORKSPACE=
